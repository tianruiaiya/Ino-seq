# Ino-seq v1.0.0 run configuration
#
# Official lifecycle:
#   ./inoseq init -> edit this file -> ./inoseq validate -> ./inoseq plan
#   -> ./inoseq submit -> ./inoseq status
# "submit" resumes automatically.  To recompute deliberately, use
#   ./inoseq submit --from-stage module01|module02|module03|module04|module05|qc|finalize
#
# REFERENCE_FASTA is required. Reusing OUTPUT_DIR enables fingerprint-checked
# resume; choose a new OUTPUT_DIR for a scientifically independent run.
# Analytical thresholds below are frozen by the v1.0.0 contract.

# Required paths and runtime
REFERENCE_FASTA=/absolute/path/to/hg38.fa
FGBIO_JAR=
PYTHON_BIN=python
OUTPUT_DIR=output
LOG_DIR=logs

# Slurm
SLURM_CPUS=40
SLURM_MEM=200G
SLURM_EXCLUDE=

# Threads / memory
FASTP_THREADS=40
CUTADAPT_THREADS=10
BWA_THREADS=40
SAMTOOLS_SORT_THREADS=4
SAMTOOLS_SORT_MEM=5G
CONSENSUS_THREADS=40
FINAL_SORT_THREADS=40
STATS_THREADS=40
GROUP_JAVA_XMX=180g
CONSENSUS_JAVA_XMX=180g
ZIPPER_JAVA_XMX=180g

# Phase A / module 01: read QC
FASTP_QUALIFIED_QUALITY_PHRED=20
FASTP_UNQUALIFIED_PERCENT_LIMIT=10
FASTP_LENGTH_REQUIRED=50
READS_TO_PROCESS=0

# Phase A / module 01: UMI extraction and grouping
UMI_R2_TRIM=12
UMI_ADAPTER=TGTAGAGCACGCGTGG
UMI_STRATEGY=Adjacency
UMI_EDITS=1

# Phase A / module 01: molecular consensus
CONSENSUS_MIN_READS=1
CONSENSUS_MIN_INPUT_BASE_QUALITY=20
FILTER_MIN_READS=1
FILTER_MIN_BASE_QUALITY=20
FILTER_MAX_BASE_ERROR_RATE=0.2

# Phase A / module 02: ABE signature-read filtering
MUTATION_LOCATION_QUAL_THRESHOLD=30

# Phase B / module 03: paired background filtering (frozen)
BACKGROUND_WINDOW=15
BACKGROUND_FOLD_CHANGE=1.5
BACKGROUND_PVALUE=0.05

# Phase B / module 04: candidate intervals (frozen)
CANDIDATE_MERGE_DISTANCE=30
CANDIDATE_MIN_LENGTH=30
CANDIDATE_MIN_READS=3

# Phase B / module 05: sgRNA-dependent classification (frozen)
OFFTARGET_SEARCH_WINDOW=25
OFFTARGET_MAX_SCORE=8
SPACER_NEIGHBORHOOD=100

# Phase B and Phase C Slurm resources
POSTPROCESS_SLURM_CPUS=8
POSTPROCESS_SLURM_MEM=32G
POSTPROCESS_SLURM_EXCLUDE=
POSTPROCESS_QC_SLURM_CPUS=2
POSTPROCESS_QC_SLURM_MEM=8G
FINALIZE_SLURM_CPUS=1
FINALIZE_SLURM_MEM=2G

# Phase C automatic aggregation
SUBMIT_QC_AFTER=1
SUBMIT_OFFTARGET_QC_AFTER=1

# Phase A cohort QC
QC_UNIQUE_MAPQ=30
QC_SLURM_CPUS=8
QC_SLURM_MEM=16G
